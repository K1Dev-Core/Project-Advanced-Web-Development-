{
  "name": "khaokong-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve app --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build app",
    "test": "playwright test --config playwright.simple.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:ui": "playwright test --config playwright.simple.config.ts --ui",
    "test:live": "playwright test --config playwright.simple.live.config.ts",
    "start:local": "ng serve app --host 127.0.0.1 --port 4201 --proxy-config proxy.local.conf.json"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.57.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
